{
  "name": "express-projekat",
  "version": "1.0.0",
  "description": "Novi Node.js i Express projekat",
  "type": "module",
  "main": "src/server.js",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:frontend": "npm run dev --prefix frontend -- --host 127.0.0.1 --open",
    "dev:all": "concurrently --kill-others --names BACKEND,FRONTEND --prefix-colors blue,magenta \"npm:dev\" \"npm:dev:frontend\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.14"
  }
}
